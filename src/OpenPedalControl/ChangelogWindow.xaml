<Window x:Class="OpenPedalControl.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new" Width="640" Height="620" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" FontSize="13" Icon="Assets/app.ico"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBackground}" Padding="28,20">
            <StackPanel>
                <TextBlock x:Name="Heading" Text="What's new" Foreground="White" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="Subheading" Foreground="{StaticResource HeaderMuted}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="20,12">
            <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <ItemsControl x:Name="Releases" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Left" Background="{StaticResource AccentBrush}" CornerRadius="9" Padding="8,1" Margin="0,0,10,0"
                                            VerticalAlignment="Center" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="NEW" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Date}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="2,0,10,0"/>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
