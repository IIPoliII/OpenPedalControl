<Window x:Class="OpenPedalControl.CalibrationWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:OpenPedalControl.Controls"
        Title="Calibration" Width="780" Height="520" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" FontSize="13"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
                <Button DockPanel.Dock="Right" Content="{Binding NextText}" IsEnabled="{Binding CanGoNext}" Click="OnNextClick"
                        IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="120"/>
                <Button DockPanel.Dock="Right" Content="Skip this one" Click="OnSkipClick" IsEnabled="{Binding IsPressStep}"
                        Style="{StaticResource QuietButton}" Margin="0,0,8,0" ToolTip="Leave this pedal as it is."/>
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="32,24,32,0">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Instruction}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="58"/>
            <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" MinHeight="18"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Items}" Margin="24,6,24,16" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="8" Padding="16,14" CornerRadius="10" Background="White" BorderThickness="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
                                <Setter Property="Opacity" Value="0.55"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="BorderBrush" Value="{Binding Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Border Width="5" Height="18" CornerRadius="2.5" Background="{Binding Accent}" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" MinHeight="34"/>
                            <c:LevelBar Width="34" Margin="0,12" HorizontalAlignment="Left" Value="{Binding Level}" Fill="{Binding Accent}"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
