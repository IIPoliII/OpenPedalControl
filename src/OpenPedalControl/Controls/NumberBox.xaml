<UserControl x:Class="OpenPedalControl.Controls.NumberBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="28" Focusable="False">
    <UserControl.Resources>
        <Style x:Key="SpinButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Delay" Value="350"/>
            <Setter Property="Interval" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Back" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#E6E9EE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#D3D8E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Frame" Background="White" BorderBrush="#C4CAD3" BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="Input" Grid.Column="0" BorderThickness="0" Background="Transparent" Padding="4,0,2,0"
                     HorizontalContentAlignment="Right" VerticalContentAlignment="Center" MaxLength="9"
                     AutomationProperties.Name="{Binding (AutomationProperties.Name), ElementName=Root}"/>
            <TextBlock Grid.Column="1" Text="{Binding Suffix, ElementName=Root}" Foreground="#667085"
                       VerticalAlignment="Center" Margin="0,0,5,0"/>

            <Border Grid.Column="2" BorderBrush="#E1E5EB" BorderThickness="1,0,0,0" CornerRadius="0,3,3,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <RepeatButton Grid.Row="0" Style="{StaticResource SpinButton}" Click="OnUpClick" ToolTip="Increase" AutomationProperties.Name="Increase">
                        <Path Data="M0,4 L3.5,0 L7,4 Z" Fill="#4B5565"/>
                    </RepeatButton>
                    <RepeatButton Grid.Row="1" Style="{StaticResource SpinButton}" Click="OnDownClick" ToolTip="Decrease" AutomationProperties.Name="Decrease">
                        <Path Data="M0,0 L3.5,4 L7,0 Z" Fill="#4B5565"/>
                    </RepeatButton>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
