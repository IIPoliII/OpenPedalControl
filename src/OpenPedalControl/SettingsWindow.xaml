<Window x:Class="OpenPedalControl.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" FontSize="13"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="20,12">
            <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" MinWidth="100"/>
        </Border>

        <StackPanel Margin="20,16,20,20">
            <!-- Startup -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="STARTUP" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <CheckBox Content="Start OpenPedalControl with Windows" IsChecked="{Binding StartWithWindows}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,4,0,0"
                               Text="Starts hidden in the notification area. Only needed for the virtual controller (vJoy); the Windows calibration works without the app running."/>
                </StackPanel>
            </Border>

            <!-- vJoy -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="VIRTUAL CONTROLLER (VJOY)" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                    <StackPanel Visibility="{Binding VJoyInstalled, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="vJoy device" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1" Height="30" VerticalContentAlignment="Center" AutomationProperties.Name="vJoy device"
                                      ItemsSource="{Binding VJoyDeviceOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding VJoyDeviceId, Mode=TwoWay}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"
                                   Text="Automatic takes the first device no other program is using, so a vJoy device already set up for something else is left alone."/>
                        <Button Content="Configure vJoy…" Command="{Binding OpenVJoyConfigCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                ToolTip="vJoy's own tool: add devices, or axes to a device."/>
                    </StackPanel>

                    <StackPanel x:Name="MissingPanel">
                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="vJoy is not installed."/>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"
                                   Text="Without vJoy you can only use the Windows calibration: a curve with one bend, stored in Windows and working with the app closed. Install vJoy for fully custom curves."/>
                        <Button Content="Install vJoy…" Click="OnInstallVJoyClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="UPDATES" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <CheckBox Content="Check for updates when the app starts" IsChecked="{Binding CheckForUpdatesOnStart}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="22,4,0,10"
                               Text="Only looks; nothing is installed without your click. Untick it to update by hand."/>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="Check now" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource SecondaryButton}"/>
                        <Button DockPanel.Dock="Left" Content="Update now" Command="{Binding InstallUpdateCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}"/>
                        <Button DockPanel.Dock="Right" Content="What's new" Click="OnChangelogClick" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                ToolTip="The changelog of every version."/>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" FontSize="12"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
