<Window x:Class="OpenPedalControl.FirmwareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pedal firmware" Width="640" Height="540" MinHeight="480" MinWidth="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource TextPrimary}">
    <DockPanel Background="{StaticResource WindowBackground}">
        <Border DockPanel.Dock="Bottom" Background="White" Padding="20,12" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <Button Content="Close" x:Name="CloseButton" Click="OnClose" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" MinWidth="100"/>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">
                <TextBlock Text="Pedal firmware" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="The firmware is included with OpenPedalControl. No download or file selection needed."
                           TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,18"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="OpenPedalControl Pedals" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="InstalledText" Margin="0,8,0,0" Text="Checking connected pedals…"/>
                                <TextBlock x:Name="IncludedText" Margin="0,4,0,0" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" x:Name="RefreshButton" Click="OnRefresh" VerticalAlignment="Top" Style="{StaticResource QuietButton}"/>
                        </Grid>
                        <Separator Margin="0,14" Background="{StaticResource CardBorder}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="LocateBackupButton" Content="Locate backup…" Click="OnBrowseBackup" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/>
                            <TextBlock x:Name="BackupText" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,16,0,12" FontSize="14"/>
                <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,12" Visibility="Collapsed"/>
                <Button Content="Prepare installation" x:Name="PrepareButton" Click="OnPrepare" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Install firmware…" x:Name="InstallButton" Click="OnInstall" IsEnabled="False" Visibility="Collapsed" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
                <TextBlock Text="For the supported HE SIM PEDALS controller. The handbrake is not supported."
                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                <Expander x:Name="Advanced" Header="Advanced options" Margin="0,18,0,0">
                    <StackPanel Margin="0,12,0,0">
                        <CheckBox x:Name="ForceReinstall" Content="Reinstall even if this version is already installed" Checked="OnFilesChanged" Unchecked="OnFilesChanged"/>
                        <CheckBox x:Name="RestoreOriginal" Content="Restore original firmware and settings from my backup" Margin="0,10,0,0" Checked="OnFilesChanged" Unchecked="OnFilesChanged"/>
                        <CheckBox x:Name="UseExternal" Content="Use a different firmware bundle" Margin="0,10,0,8" Checked="OnFilesChanged" Unchecked="OnFilesChanged"/>
                        <DockPanel x:Name="BundlePanel">
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseBundle" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                            <TextBox x:Name="BundlePath" Height="30" VerticalContentAlignment="Center" TextChanged="OnFilesChanged" AutomationProperties.Name="External firmware bundle"/>
                        </DockPanel>
                        <TextBlock Text="Original backup folder" Style="{StaticResource Muted}" Margin="0,12,0,4"/>
                        <TextBox x:Name="BackupPath" Height="30" VerticalContentAlignment="Center" TextChanged="OnFilesChanged" AutomationProperties.Name="Original backup folder"/>
                        <Button Content="Verify selected files" x:Name="FilesButton" Click="OnVerifyFiles" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Margin="0,10"/>
                        <TextBlock x:Name="Review" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Enter update mode" x:Name="BootButton" Click="OnEnterBoot" Style="{StaticResource SecondaryButton}"/>
                            <Button Content="Check controller" x:Name="CheckButton" Click="OnCheck" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"/>
                            <Button Content="Restart controller" x:Name="RestartButton" Click="OnRestart" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <TextBlock Text="Experimental firmware: 3 load-cell inputs; extra axes and buttons are not implemented. The original bootloader is preserved. A damaged bootloader still needs C2 recovery."
                                   TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                        <TextBlock x:Name="LogPath" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
